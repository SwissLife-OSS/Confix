<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Thin .NET options binding and validation for Confix.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Confix.Abstractions/Confix.Abstractions.csproj" />
        <!-- Build-only: the generator ships inside this package as an analyzer. -->
        <ProjectReference Include="../Confix.CodeGeneration/Confix.CodeGeneration.csproj"
                          PrivateAssets="all" ReferenceOutputAssembly="false" />
        <!-- Keep the dependency floor low so applications are not forced to upgrade. -->
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" VersionOverride="10.0.0" />
    </ItemGroup>

    <Target Name="PackRegistrationGenerator" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="$(MSBuildThisFileDirectory)../Confix.CodeGeneration/bin/$(Configuration)/netstandard2.0/Confix.CodeGeneration.dll"
                  Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Confix.Tool.Tests" />
    </ItemGroup>

</Project>
